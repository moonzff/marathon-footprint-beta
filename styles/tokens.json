{
  "$meta": {
    "brand": "Runprint 跑印",
    "system": "显影 / Darkroom",
    "version": "1.0",
    "modes": ["dark (身份/峰值)", "light (工具/正文)"],
    "rule": "金=哑光旧金(非奖牌亮金/非冷银);黑=暖向带褐(非纯黑、非冷蓝黑)"
  },
  "color": {
    "bg": "#0E0F0D",
    "bgDeep": "#0B0C0A",
    "card": "#15140F",
    "cardRaised": "#1C1810",
    "greenShadow": "#161C18",
    "border": "#23211A",
    "goldDim": "#7A6442",
    "goldDeep": "#B68A3E",
    "gold": "#C99A55",
    "goldHi": "#E8C07A",
    "ivory": "#E8D6A8",
    "fix": "#FBF4E2",
    "ember": "#8C2D1E",
    "paper": "#F4ECDA",
    "paperRaised": "#FBF6E9",
    "ink": "#1A1714",
    "text": "#E9E2D2",
    "textStrong": "#F6EEDD",
    "textMuted": "#8D8674",
    "textFaint": "#6E6A5A"
  },
  "gradient": {
    "gold": "linear-gradient(90deg,#C99A55,#E8C07A)",
    "develop": "linear-gradient(90deg,#0E0F0D 0%,#7A6442 40%,#C99A55 64%,#E8D6A8 88%,#FBF4E2 100%)",
    "card": "radial-gradient(120% 90% at 64% 4%,#1D2A20,#12160F 64%)"
  },
  "font": {
    "serif": "'Noto Serif SC','Songti SC',serif",
    "serifEn": "'Playfair Display',Georgia,serif",
    "sans": "'Inter','Noto Sans SC',-apple-system,'PingFang SC',sans-serif",
    "mono": "'IBM Plex Mono','SF Mono',ui-monospace,Menlo,monospace"
  },
  "radius": { "chip": 11, "sm": 13, "md": 16, "lg": 20, "phone": 42 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 22, "6": 30, "7": 44 },
  "fontSize": { "display": 56, "h1": 34, "h2": 23, "title": 16, "body": 14, "caption": 11, "micro": 10 },
  "rules": {
    "data": "成绩/配速/等级/百分位/日期 一律 mono + font-variant-numeric:tabular-nums",
    "emberMaxArea": "<3% (仅 CTA/验证语境)",
    "totemWatermarkOpacity": "0.08–0.16",
    "minTouchTarget": "44px"
  },
  "logo": {
    "mainMark": "assets/logo-totem.png  (主标=图腾·指纹奔跑者;创始人 2026-06-20 定为主 logo)",
    "primary": "assets/logo-totem.png  (主标:图腾·指纹奔跑者 · 工作主力/App/favicon/主视觉/段位章/水印)",
    "secondary": "assets/logo-primary.png  (辅标:R+足印 · 字标锁定/横向/极小尺寸备用)",
    "totem": "assets/logo-totem.png  (同主标;低透明水印 opacity 0.08–0.16)",
    "seal": "assets/logo-seal.png  (邮戳认证戳 · 完赛认证/验真/钤印)",
    "sealLight": "assets/logo-seal-light.png  (纸白亮态认证戳)",
    "variants": "assets/logo-variants.png  (仅符号/单色/反白/小尺寸 规格)",
    "note": "PNG 透明底,可置任意背景;不得在调色板外重新着色。主 logo=图腾;极小尺寸(≤20px)可回退辅标 R+足印或图腾仅符号裁切。"
  }
}
